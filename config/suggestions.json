    {
      "id": "rule_1",
      "title": "心率节律监测",
      "text": "若心率明显偏快或偏慢，建议复核当前状态后继续动态监测，必要时进行门诊复诊。"
    },
    {
      "id": "rule_2",
      "title": "传导功能评估",
      "text": "若 PR/QRS 发生明显延长或增宽，建议加强传导功能评估并排除药物或电解质影响。"
    },
    {
      "id": "rule_3",
      "title": "复极状态复核",
      "text": "若 QTc 或 ST_shift 异常，建议结合临床症状与既往病史进行复核，警惕缺血或离子紊乱。"
    },
    {
      "id": "rule_4",
      "title": "HRV 稳定性关注",
      "text": "若 RR_std、SDNN、RMSSD 下降明显，提示自主神经调节异常，建议进一步观察并进行生活方式干预。"
    },
    {
      "id": "rule_5",
      "title": "波形形态重点观察",
      "text": "若 P 波或 T 波振幅异常，建议对比既往波形并评估是否存在炎症、药物或电解质因素。"
    },
    {
      "id": "rule_6",
      "title": "双通路人工复核",
      "text": "模型与规则结果应作为辅助参考，最终临床判断仍需要经验丰富的医生结合波形及病史做出。"
    }
  ],
